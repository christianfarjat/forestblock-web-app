{
  "$schema": "https://turbo.build/json/schema.json",
  "globalDependencies": ["**/.env.local", "**/.env"],
  "pipeline": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "cache": true
    },
    "test": {
      "cache": true,
      "outputs": ["coverage/**"]
    },
    "lint": {
      "cache": true
    },
    "type-check": {
      "cache": true
    }
  }
}
