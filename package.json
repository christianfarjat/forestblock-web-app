{
  "name": "forestblock-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ForestBlock ESG Suite — Monorepo with shared packages and standalone carbonTrack",
  "scripts": {
    "dev": "turbo dev",
    "dev:fb": "cd apps/forestblock-web-app && pnpm dev",
    "dev:ct": "cd apps/carbontrack && pnpm dev",
    "build": "turbo build",
    "build:fb": "cd apps/forestblock-web-app && pnpm build",
    "build:ct": "cd apps/carbontrack && pnpm build",
    "test": "turbo test",
    "test:ui": "turbo test:ui",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
