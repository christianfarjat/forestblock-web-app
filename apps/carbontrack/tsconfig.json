{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "inlineSourceMap": false,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@forestblock/types": ["../../packages/types"],
      "@forestblock/types/*": ["../../packages/types/*"],
      "@forestblock/data": ["../../packages/data"],
      "@forestblock/data/*": ["../../packages/data/*"],
      "@forestblock/ui": ["../../packages/ui"],
      "@forestblock/ui/*": ["../../packages/ui/*"],
      "@forestblock/utils": ["../../packages/utils"],
      "@forestblock/utils/*": ["../../packages/utils/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
