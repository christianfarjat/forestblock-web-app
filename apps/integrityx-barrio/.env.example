# IntegrityX Barrio — variables de entorno (Fase 1)
# Sin NEXT_PUBLIC_IXB_API_URL la app corre en MODO DEMO (datos seed locales,
# sellado blockchain simulado). Con URL, el cliente ixb_api apunta al backend real.
NEXT_PUBLIC_IXB_API_URL=

# Fase 1/2 — servicios reales (server-side, nunca NEXT_PUBLIC):
# CLIMATIQ_API_KEY=          # factores de emisión (https://www.climatiq.io/docs)
# POLYGON_RPC_URL=           # anclaje hash-stamp en Polygon PoS
# CHAIN_PRIVATE_KEY=         # en Secret Manager, jamás en el repo
# GOOGLE_GENAI_API_KEY=      # OCR de facturas / asistente (Fase 2)
# FIREBASE_CONFIG=           # SSO IntegrityX (custom claims de rol)
