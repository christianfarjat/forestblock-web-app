{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "apps/prisma-esg-frontend/.next"
      }
    }
  ],
  "projects": {
    "forestblock-web-app": {
      "name": "forestblock-web-app",
      "autoExposeSystemEnvs": true,
      "buildCommand": "cd apps/prisma-esg-frontend && pnpm build",
      "devCommand": "cd apps/prisma-esg-frontend && pnpm dev",
      "installCommand": "pnpm install",
      "framework": "nextjs",
      "rootDirectory": "apps/prisma-esg-frontend"
    }
  }
}
